# Listmonk Configuration
# Your self-hosted Listmonk instance URL (e.g., https://listmonk.yourdomain.com)
LISTMONK_HOST=https://listmonk.example.com

# Listmonk API credentials (create an API user in Admin > Users)
LISTMONK_API_USER=your_api_username
LISTMONK_API_TOKEN=your_api_token

# The numeric ID of your mailing list (find in Listmonk Admin > Lists)
LISTMONK_LIST_ID=1
