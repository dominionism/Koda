# Koda voice gateway — environment template.
# Copy to Server/.env and fill in. NEVER commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────
# Groq powers the fast layer (router/status/beats) + Whisper STT. Free tier OK:
# https://console.groq.com
GROQ_API_KEY=

# LiveKit server the gateway + your frontend join. `livekit-server --dev`
# defaults shown.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The brain: a host running the ZeroClaw runtime. The gateway spawns
# `ssh $KODA_ORCH_HOST $KODA_ORCH_BIN acp` and keeps it warm. When the brain is
# on THIS same machine, set KODA_ORCH_HOST=local — the gateway spawns it
# directly (no sshd needed, faster, one less failure point).
KODA_ORCH_HOST=you@your-brain-host
KODA_ORCH_BIN=/home/you/.zeroclaw/bin/zeroclaw
# Where the brain reads/writes code (its agent workspace on the brain host).
KODA_PROJECT_DIR=/home/you/.zeroclaw/agents/default/workspace

# ── Optional (defaults shown) ────────────────────────────────────────────────
# KODA_TTS=                    # edge | groq | cartesia | kokoro; unset = edge
#                              # (free Microsoft Edge neural TTS — no key, no rate
#                              # limits — Koda's default voice). groq/cartesia/
#                              # kokoro stay selectable.
# KODA_EDGE_VOICE=en-GB-SoniaNeural  # any edge-tts voice (e.g. en-US-EmmaMultilingualNeural, en-US-AvaNeural)
# KODA_GROQ_VOICE=autumn
# KODA_ROOM_NAME=koda-dev
# KODA_ORCH_AGENT=default
# KODA_ORCH_SPAWN_ENV=         # extra "K=V K2=V2" exported inside the brain
#                              # process (e.g. HOME=/path/to/isolated-home for a
#                              # credential-isolated second agent)
# KODA_WEB_PORT=8800           # serve.py port
# KODA_PUBLIC_LK_URL=          # serve.py /token url override (else derived
#                              # from the request Host)
# CARTESIA_API_KEY=            # set to use Cartesia TTS; empty = local Kokoro
# KOKORO_VOICE=af_heart
# GROQ_MODEL=llama-3.3-70b-versatile
# KODA_JOURNAL_PATH=~/.koda/journal.jsonl
# KODA_ACP_SESSION_CACHE=~/.koda-acp-session

# ── Voice↔Runtime Bridge (the managed-tier work path) ────────────────────────
# When ON, a spoken WORK request runs in a fresh, disposable Runtime-Layer box
# (create → work → destroy) instead of on the ZeroClaw brain. Recall / status /
# greeting still use the brain. Point KODA_RUNTIME_URL at a running runtime
# server (`cd runtime && KODA_API_KEY=… node dist/server-entry.js`), Docker up.
# KODA_USE_RUNTIME_JOBS=0        # 1 = work runs in Runtime boxes; 0 = legacy brain
# KODA_RUNTIME_URL=http://localhost:3100     # the runtime HTTP server
# KODA_RUNTIME_TOKEN=            # must equal the server's KODA_API_KEY (bearer)
# KODA_RUNTIME_USER_ID=dev       # workspace identity base (one box per job)
# KODA_RUNTIME_PROJECT=runtime-workspace     # label recorded in the journal
# KODA_RUNTIME_JOB_DEADLINE=300  # per-job wall-clock ceiling (seconds)
# KODA_RUNTIME_AGENT=opencode    # coding CLI in the box: opencode | omp
#   OMP is the launch default but needs a model + provider config (BYOK). It has
#   no env overrides — the box's omp-launch shim writes ~/.omp/agent/*.yml from
#   these, so the user's key rides inside OMP_MODELS_YML (never logged here):
# OMP_MODELS_YML=|                # provider block (YAML); apiKey inlined
#   providers:
#     groqcap: { baseUrl: https://api.groq.com/openai/v1, api: openai-completions,
#       apiKey: gsk_…, models: [{ id: llama-3.3-70b-versatile, contextWindow: 32000, maxTokens: 1500 }] }
# OMP_CONFIG_YML=|                # pins the default model
#   modelRoles: { default: groqcap/llama-3.3-70b-versatile }
# OMP_ACP_ARGS=--tools read,write,edit   # optional: slim the tool prompt (low-TPM keys)
# KODA_MIC_GAIN=4.0
# KODA_VAD_CONFIDENCE=0.6
# KODA_VAD_STOP_SECS=0.35
# KODA_VAD_MIN_VOLUME=0.03
# KODA_HOLDING_SECS=1.5
# KODA_STALL_TIMEOUT=120
